# Copy to .env.local for development. In production set these in Vercel → Project → Settings →
# Environment Variables (separate values for Preview/Development and Production). Never commit real values.
#
# Leave the Supabase values empty to run the browser-only demo with sample data.

# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Full database access: never prefix with NEXT_PUBLIC_, never paste into the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The site's own address, used in invitation and password-reset links (https in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Twilio (SMS). Console → Account info. Server only: never NEXT_PUBLIC_, never in URLs or logs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS parts per garage per rolling 24 hours (protects against runaway sending). Default 300.
SMS_DAILY_LIMIT=300
# Development only: a visibly labelled fake provider. Ignored on the production deployment.
SMS_SIMULATE=


# Public HTTPS URL of the signed Revloop Windows installer. Leave blank to hide the link.
REVLOOP_WINDOWS_DOWNLOAD_URL=
